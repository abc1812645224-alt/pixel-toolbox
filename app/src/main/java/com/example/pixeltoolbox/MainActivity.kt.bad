@Composable

private fun DisclaimerSection(title: String, content: @Composable () -> Unit) {

    Column(modifier = Modifier.fillMaxWidth().padding(bottom = 16.dp)) {

        Text(

            title,

            fontSize = 14.sp,

            fontWeight = FontWeight.Bold,

            color = iOSLabel

        )

        Spacer(Modifier.height(6.dp))

        content()

    }

}

/**
 * 查询系统当前 power mode（0=省电 / 1=均衡 / 2=性能，与 cmd power set-mode 0/1/2 对应）。
 * 多层探测：cmd power get-mode → dumpsys power 的 mPowerMode / PowerMode 字段 → 系统省电开关辅助判断。
 * 返回 "saver" / "balanced" / "performance"；无法确定时返回 null，由调用方回退本地偏好。
 */
private fun querySystemPowerMode(): String? {
    if (!ShizukuUtils.hasShizukuPermission()) return null
    val candidates = listOf(
        "cmd power get-mode 2>/dev/null",
        "dumpsys power 2>/dev/null | grep -oE 'mPowerMode=[0-9]+' | head -n1 | cut -d= -f2",
        "dumpsys power 2>/dev/null | grep -oE 'PowerMode=[0-9]+' | head -n1 | cut -d= -f2"
    )
    for (cmd in candidates) {
        val out = ShizukuUtils.executeCommandOrNull(cmd)?.trim() ?: continue
        val mode = parsePowerModeNumber(out)
        if (mode != null) return mode
    }
    // 辅助判断：系统低电耗（省电）开关开启时归为省电
    val lowPower = ShizukuUtils.executeCommandOrNull("settings get global low_power 2>/dev/null")?.trim()
    if (lowPower == "1") return "saver"
    return null
}

private fun parsePowerModeNumber(raw: String): String? = when (raw.trim()) {
    "0" -> "saver"
    "1" -> "balanced"
    "2" -> "performance"
    else -> null
}

/**
 * 查询系统当前屏幕密度（wm density），返回实际生效值。
 * 优先解析 Override density（覆盖密度，存在时即生效值），其次 Physical density（物理密度）；
 * 两者皆无时尝试纯数字输出（旧版 wm 直接输出密度值）。无法确定时返回 null，由调用方保持现状。
 */
private fun querySystemDensity(): Int? {
    if (!ShizukuUtils.hasShizukuPermission()) return null
    val out = ShizukuUtils.executeCommandOrNull("wm density 2>/dev/null") ?: return null
    Regex("""Override density:\s*(\d+)""").find(out)?.let { return it.groupValues[1].toIntOrNull() }
    Regex("""Physical density:\s*(\d+)""").find(out)?.let { return it.groupValues[1].toIntOrNull() }
    return out.trim().toIntOrNull()
}


